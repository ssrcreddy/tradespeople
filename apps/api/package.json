{
  "name": "@qa/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --watch src/server.ts",
    "start": "node src/server.ts",
    "migrate": "node --env-file-if-exists=../../.env src/db/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@qa/shared": "workspace:*",
    "better-auth": "^1.7.15",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "fast-check": "^4.10.2",
    "vitest": "^5.0.5"
  }
}
