{
  "name": "@qa/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --watch src/server.ts",
    "start": "node src/server.ts",
    "migrate": "node --env-file-if-exists=../../.env src/db/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json",
    "eval": "node --env-file-if-exists=../../.env scripts/eval.ts",
    "worker": "node --env-file-if-exists=../../.env --watch src/worker.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@fastify/multipart": "^10.1.6",
    "@fontsource/noto-sans": "^5.3.0",
    "@qa/shared": "workspace:*",
    "better-auth": "^1.7.15",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "heic-convert": "^2.1.0",
    "openai": "^6.49.0",
    "pdfkit": "^0.17.2",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.0",
    "resend": "^6.37.0",
    "sharp": "^0.34.5",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "fast-check": "^4.10.2",
    "vitest": "^5.0.5"
  }
}
