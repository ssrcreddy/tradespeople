# Copy to .env and fill in. Never commit .env.

# --- Database (infra/docker-compose.yml) ---
# The non-owner "app" role (no BYPASSRLS) is created by the first migration (Days 2–5).
DATABASE_URL=postgres://app:app@localhost:56432/quotes
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:56432/quotes
APP_DB_PASSWORD=app             # password migrate.ts sets on the "app" role; must match DATABASE_URL

# --- Email (Resend) ---
RESEND_API_KEY=
RESEND_INBOUND_SECRET=          # webhook signing secret for the inbound endpoint (whsec_...)
RESEND_EVENTS_SECRET=           # webhook signing secret for outbound delivery events
INTAKE_DOMAIN=                  # e.g. intake.example.com
SENDER_ADDRESS=                 # e.g. quotes@example.com

# --- LLM (exact snapshot IDs, never moving aliases) ---
OPENAI_API_KEY=
STRONG_MODEL=
SMALL_MODEL=
# Development only, when no OpenAI key: answer every extraction from a fixture.
# FAKE_LLM_FILE=../../data/dev/fake-extraction.json

# --- Auth ---
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:8080
WEB_ORIGIN=http://localhost:3000

# --- Object storage (SeaweedFS locally, R2/S3 in production) ---
S3_ENDPOINT=http://localhost:8333
S3_BUCKET=quotes-dev
S3_ACCESS_KEY_ID=dev-access-key
S3_SECRET_ACCESS_KEY=dev-secret-key

# --- Ops ---
SENTRY_DSN=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
INTAKE_RATE_LIMIT_PER_HOUR=30
NODE_ENV=development

# --- Day-1 spike only ---
SPIKE_INBOUND_PORT=8787
