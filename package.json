{
  "name": "quotes-agent",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=9"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @qa/api test",
    "migrate": "pnpm --filter @qa/api migrate",
    "dev:api": "pnpm --filter @qa/api dev",
    "dev:infra": "docker compose -f infra/docker-compose.yml up -d",
    "spike:photo": "pnpm --filter @qa/spikes photo",
    "spike:pdf": "pnpm --filter @qa/spikes pdf",
    "spike:schema": "pnpm --filter @qa/spikes schema",
    "spike:extract": "pnpm --filter @qa/spikes extract",
    "spike:inbound": "pnpm --filter @qa/spikes inbound",
    "eval": "pnpm --filter @qa/api eval",
    "dev:worker": "pnpm --filter @qa/api worker",
    "dev:web": "pnpm --filter @qa/web dev"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
